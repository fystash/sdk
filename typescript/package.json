{
  "name": "@fystash_ai/sdk",
  "version": "0.1.3",
  "description": "Fystash SDK: HTTP RoomClient + fabric wire FystashClient (Org → Room → Sandboxes + Fabric + Drive)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./room": {
      "types": "./dist/room.d.ts",
      "import": "./dist/room.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "pbjs -t static-module -w es6 -o src/_generated/fabric.js ../../proto/fabric.proto && pbts -o src/_generated/fabric.d.ts src/_generated/fabric.js",
    "build": "tsc -p tsconfig.json && mkdir -p dist/_generated && cp src/_generated/fabric.js dist/_generated/fabric.js && cp src/_generated/fabric.d.ts dist/_generated/fabric.d.ts",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fystash/sdk.git",
    "directory": "typescript"
  },
  "homepage": "https://fystash.ai",
  "bugs": {
    "url": "https://github.com/fystash/sdk/issues"
  },
  "keywords": [
    "fystash",
    "sandbox",
    "firecracker",
    "multi-agent",
    "fabric"
  ],
  "author": "Fystash",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "protobufjs-cli": "^2.6.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "protobufjs": "^8.7.1"
  }
}
